# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=mempire
PORT=8787

# Production: lock CORS to the deployed app origin(s), comma-separated.
# Unset = open (development).
CORS_ORIGIN=https://mempire.fun

# Devnet starter-kit faucet. A base58 secret key whose ONLY power is spending
# what it holds — never the admin/upgrade-authority key. Generate and stock it
# with `chain/scripts/setup-faucet.ts`, which prints this value. Unset means the
# faucet endpoint reports itself unavailable and the UI never offers it.
FAUCET_SECRET=
