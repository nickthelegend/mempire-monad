# Copy to .env.local (or set in the host's dashboard). All optional in local dev.

# The relay: matchmaker, onboarding, Pyth proxy, NFT metadata. ws:// is derived.
VITE_API_URL=http://localhost:8787

# 10143 = Monad testnet (default). 31337 = local anvil on :8611 with mock Pyth/AUSD.
VITE_CHAIN_ID=10143

# Optional RPC override (e.g. an Alchemy Monad testnet URL). Defaults to the public RPC.
# VITE_RPC_URL=https://testnet-rpc.monad.xyz

# Optional: the Envio GraphQL endpoint that powers leaderboards and the play feed.
# VITE_INDEXER_URL=
