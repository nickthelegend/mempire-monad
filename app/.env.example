# Copy to .env (or set in the host's dashboard). All optional in local dev.

# The persistence + matchmaker API. ws:// for PvP is derived from this.
VITE_API_URL=http://localhost:8787

# Solana RPC. The public devnet endpoint rate-limits; a Helius/Triton/QuickNode
# devnet URL makes mint/stake noticeably snappier.
VITE_RPC_URL=https://api.devnet.solana.com

# Cluster label shown in the ChainBadge and used for explorer links.
VITE_CLUSTER=devnet
